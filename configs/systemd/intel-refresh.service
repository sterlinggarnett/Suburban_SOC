# Suburban-SOC — refresh the Zeek threat-intel feed (WS1.3 / #222) and index it
# into threat-intel-indicators + threat-intel-meta (the freshness heartbeat
# slo_metrics.py's metric_intel_feed_stale_heartbeats() and the "Threat Intel
# Feed Health" dashboard read — #358: the rules/elastic_watcher/intel_feed_
# stale.json Watcher this used to say "Watcher" is retired, never actually
# fired on this Basic-license stack).
# Triggered by intel-refresh.timer every 6 hours. Replaces the old manual
# `crontab -l | cat - configs/intel/intel-refresh.cron | crontab -` install
# step (configs/intel/intel-refresh.cron, removed) — #222's acceptance
# criterion was that install stop being a manual runbook step.
#
# Install: scripts/setup/install_intel_refresh_timer.sh (idempotent, does the
# cp/daemon-reload/enable --now below and runs the service once to verify).
# Manual equivalent:
#   sudo cp configs/systemd/intel-refresh.{service,timer} /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now intel-refresh.timer
# Run once now / check:  sudo systemctl start intel-refresh.service ; journalctl -u intel-refresh -n 30
[Unit]
Description=Suburban-SOC threat-intel feed refresh (Feodo Tracker + Emerging Threats)
Documentation=https://github.com/voltron-1/Suburban_SOC
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Runs as the repo owner so it can read scripts/setup/.env, write
# configs/intel/data/intel.dat (#270 — was configs/intel/intel.dat directly),
# and use the user's Docker context for the CA extraction below — same
# posture as slo-metrics.service.
User=tjlam
# security-auditor review (#271; empirically re-confirmed live via
# `systemd-run --user` against a throwaway unit on this exact host):
# systemd's Environment= directive does NOT perform ${VAR} expansion — per
# systemd.exec(5), "$" has no special meaning there. The prior line here,
# `Environment=ES_PASS=${INTEL_WRITER_PASSWORD}`, resolved to the LITERAL
# 24-ish-character string "${INTEL_WRITER_PASSWORD}", not the real
# password — every scheduled (timer-triggered) run of this unit has been
# authenticating to ES with that literal string and 401ing on both the
# bulk index and the heartbeat write, silently (refresh_intel.sh sets
# status="stale" and logs a WARN, but nothing ships configs/network/
# filebeat.yml's Zeek-log-only scope to the SIEM). This is the exact bug
# class #259 already found and fixed once for slo-metrics.service (see
# that unit's own long comment on this) — reintroduced here and in
# checkpoints-compact.service (tracked separately, out of scope here;
# that one isn't installed on this host). Fixed the same way #259 fixed
# it: extract ONLY the one secret this unit needs, comment-stripped the
# same way scripts/setup/lib/env_loader.py strips them, into a scratch
# file under RuntimeDirectory= — EnvironmentFile=- then supplies ES_PASS
# directly, no expansion needed. `grep -Eq "^ES_PASS=.{8,}"` (not
# `test -s`): a typo'd/rotated-away INTEL_WRITER_PASSWORD key, or a blank
# value, must fail this step loudly rather than silently write an empty/
# near-empty scratch file.
# `| tail -n 1` (#357 security-auditor round 2): if .env ever has TWO
# INTEL_WRITER_PASSWORD= lines (a botched rotation), the grep above
# matches both — EnvironmentFile= is last-wins (empirically confirmed
# live via `systemd-run --user`), but the `grep -Eq` guard without this
# would only need ONE of the two lines to pass, so a valid first line
# could mask a bad/blank second one that's actually what gets exported.
# tail -n 1 makes the guard validate the exact line that wins.
ExecStartPre=/bin/sh -c 'grep "^INTEL_WRITER_PASSWORD=" /home/tjlam/projects/Suburban-SOC/scripts/setup/.env | sed -E "s/^INTEL_WRITER_PASSWORD=/ES_PASS=/; s/[ \t]+#.*//" | tail -n 1 > /run/suburban-soc-intel/intel_writer_password.env; grep -Eq "^ES_PASS=.{8,}" /run/suburban-soc-intel/intel_writer_password.env'
# "-" prefix REQUIRED (security-auditor precedent, slo-metrics.service):
# every Exec* command in this unit, including the ExecStartPre above that
# CREATES this file, has EnvironmentFile= applied before it execs — without
# "-", a missing file would deadlock the unit's very first command on every
# single run (RuntimeDirectory= is torn down between runs, Type=oneshot).
# refresh_intel.sh already degrades gracefully with no ES creds at all
# (security-auditor review, #222) — a missing/empty scratch file here just
# makes ES_PASS empty, which refresh_intel.sh's own
# ES_PASS="${ES_PASS:-${ELASTIC_PASSWORD:-}}" fallback then leaves empty
# too (no ELASTIC_PASSWORD is set in this unit's environment), so indexing
# is skipped rather than attempted with a wrong credential.
EnvironmentFile=-/run/suburban-soc-intel/intel_writer_password.env
Environment=ES_URL=https://localhost:9200
# #222 (security-auditor review): dedicated least-privilege identity, NOT
# the elastic superuser — refresh_intel.sh's own ES_USER default (elastic)
# was fine for an occasional manual run, but this unit makes it a persistent
# scheduled service, which is exactly the change apply_roles.sh:8's "no
# service uses the elastic superuser in normal operation" control is meant
# to prevent. configs/elasticsearch/roles/intel_writer.json /
# scripts/setup/docker-compose.yml's provision step grant only
# create_index/index on threat-intel-indicators + threat-intel-meta - no
# read, no delete, nothing else.
Environment=ES_USER=intel_writer
Environment=ES_CA=/run/suburban-soc-intel/ca.crt
# /run/suburban-soc-intel, owned by the service user; auto-removed when the
# unit stops. Mode 0700 (not the 0755 default): the password scratch
# file's 0600 permissions would otherwise rest entirely on UMask=0077
# below applying to whatever the ExecStartPre writes it as — a
# non-traversable directory makes the guarantee structural, not incidental
# (same reasoning as slo-metrics.service's identical directive). The stack
# CA lives only in a docker volume (no stable host path under Docker
# Desktop/WSL on this host's current setup), so pull it from the ES
# container each run, matching slo-metrics.service's approach. Idempotent;
# a failed extract still lets refresh_intel.sh run (it only needs ES_CA
# for the optional indexing step, gated on ES_PASS being set — a missing/
# unreadable CA there fails closed via es_common.sh's own check, not
# silently).
RuntimeDirectoryMode=0700
RuntimeDirectory=suburban-soc-intel
# #270 (security-auditor review): the docker cp below re-fetches the ES CA
# from the `elasticsearch` container on EVERY run with no verification —
# whatever sits at that container path becomes the sole trust anchor for a
# request carrying the intel_writer credential. An attacker able to write
# into that container path, or start a container named `elasticsearch`
# first, could MITM the connection and harvest it. scripts/setup/
# verify_ca_fingerprint.sh pins the fingerprint seen on the FIRST run this
# host ever makes (a repo-committed static pin isn't possible — the real
# value depends on each deployment's own generated CA, which this repo has
# no access to) and hard-fails + deletes ca.crt on any later mismatch.
# StateDirectory (NOT RuntimeDirectory, which is torn down between every
# Type=oneshot run) persists that pin across runs so a LATER swap is still
# caught — see the script's own header for the full reasoning.
# "-" prefixed, matching this unit's existing graceful-degradation posture
# (refresh_intel.sh already runs fine with no ES_CA at all — see the
# comment above): a deleted/untrusted ca.crt here just makes the later
# indexing step fail closed via es_common.sh's own missing-CA check, the
# same as if extraction itself had failed, rather than taking down the
# primary intel.dat refresh over a credential-only concern.
StateDirectory=suburban-soc-intel
ExecStartPre=-/usr/bin/docker cp elasticsearch:/usr/share/elasticsearch/config/certs/ca/ca.crt /run/suburban-soc-intel/ca.crt
ExecStartPre=-/usr/bin/bash /home/tjlam/projects/Suburban-SOC/scripts/setup/verify_ca_fingerprint.sh /run/suburban-soc-intel/ca.crt /var/lib/suburban-soc-intel/ca_fingerprint.sha256
# Invoked via `bash <path>`, not the script's own execute bit: this repo's
# core.fileMode=false means no .sh file is git-tracked as executable (fresh
# clone always yields 644) — caught by `systemd-analyze verify` failing with
# "not executable" against a from-scratch checkout, a real latent bug the old
# `./configs/intel/refresh_intel.sh` cron line already had.
ExecStart=/usr/bin/bash /home/tjlam/projects/Suburban-SOC/configs/intel/refresh_intel.sh
WorkingDirectory=/home/tjlam/projects/Suburban-SOC
# refresh_intel.sh exits 2 when a feed fetch failed/was empty (status=stale) —
# that is a successful run reporting degraded feed health, not a job failure;
# slo_metrics.py's metric_intel_feed_stale_heartbeats() is what actually
# alerts on it (#358). Treat 0 and 2 as success so the timer is not marked
# failed (same convention as slo-metrics.service's own breach-is-not-failure
# exit code).
SuccessExitStatus=0 2
# Default DefaultTimeoutStartSec (90s on stock systemd) can land mid-write
# under worst-case latency: 2x `curl --max-time 30` feed fetches + two
# `--max-time 60` ES calls (es_common.sh) is up to ~180s. A SIGTERM mid-write
# to intel.dat while Zeek has it open in RERELOAD mode risks a truncated read
# (security-auditor review) — generous headroom, not tuned to the worst case
# exactly, since a slow run finishing late is far cheaper than one killed
# mid-write.
TimeoutStartSec=300
# Bounds the two curl fetches, which read an entire third-party HTTP response
# into a bash variable with no size limit of its own (security-auditor
# review) — a compromised/misbehaving feed endpoint serving many hundreds of
# MB would otherwise pressure host memory hard enough to threaten ES,
# without ever showing up as an "intel job" alert. 256M is comfortably above
# the largest feed observed live (Emerging Threats compromised-ips.txt, ~25KB).
MemoryMax=256M

# --- Sandboxing (audit #167 / NIST CM-7) ---------------------------------------
# Outbound HTTPS to two intel feeds + Elasticsearch, reads .env, writes only to
# its own repo subdirectory and (if present) the live-capture intel dir — no
# special Linux capabilities, kernel access, or namespace privileges needed.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
# #270 (security-auditor review): scoped to configs/intel/data/ specifically —
# NOT the parent configs/intel/, which also holds config.zeek (Zeek policy,
# executed as root by zeek-host-capture.service) and refresh_intel.sh itself.
# The prior grant on the parent directory gave this sandboxed process write
# access to files that get executed with a much higher privilege elsewhere;
# a compromise of this process via any vector OTHER than feed content (already
# fully IPv4/bogon-sanitized by refresh_intel.sh before it reaches any sink)
# could plant code in config.zeek that root's own cp then deploys and Zeek
# executes on the next capture restart. refresh_intel.sh's own OUT/DATA_DIR
# now points here — this directory holds ONLY regenerated data (intel.dat),
# nothing Zeek or any other process interprets as code, so even a full write
# compromise of this narrower path can no longer reach config.zeek at its
# repo source. config.zeek/refresh_intel.sh/intel.seed.dat stay read-only to
# this unit under ProtectHome=read-only (no explicit grant needed — that's
# the point).
ReadWritePaths=/home/tjlam/projects/Suburban-SOC/configs/intel/data
# "-" prefix: do not fail the unit if this path does not exist on this host
# (refresh_intel.sh itself already handles that gracefully — see its
# `if [[ -d "$LIVE_DIR" ]]` check).
ReadWritePaths=-/storage/PCAP/intel
PrivateTmp=true
ProtectClock=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectControlGroups=true
ProtectHostname=true
RestrictNamespaces=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
# Deliberately NOT RemoveIPC=true (security-auditor review): that directive
# removes ALL System V/POSIX IPC objects owned by the unit's UID when the
# unit stops. User=tjlam is the interactive login account (same as
# slo-metrics.service), and Type=oneshot means this unit stops after every
# single run - every 6h it would be eligible to tear down IPC objects
# belonging to other tjlam-owned processes (desktop session, Docker Desktop
# helpers) that have nothing to do with this service. refresh_intel.sh uses
# no IPC of any kind, so the directive would protect nothing here anyway.
UMask=0077
CapabilityBoundingSet=
SystemCallArchitectures=native
# AF_NETLINK is required, not optional: glibc's getaddrinfo() (used by curl
# for the two feed URLs and by the ES calls) enumerates local addresses over
# netlink - omitting it breaks DNS resolution outright (security-auditor
# review, verified against this exact directive set working for
# slo-metrics.service in production).
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
PrivateDevices=true
ProtectProc=invisible
ProcSubset=pid

[Install]
WantedBy=multi-user.target
