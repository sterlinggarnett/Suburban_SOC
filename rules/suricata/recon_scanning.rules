# University SOC starter set — Category 9: Reconnaissance & scanning (#446, M23 Stage 3)
# SIDs 9000081-9000090.
#
# Source: university_soc_starter_ruleset.rules, supplied by the repo owner.
# Rule text below is VERBATIM from that source. ALL RULES DISABLED — see
# rules/suricata/auth_sso_abuse.rules' header for the full disable/
# provenance note (applies identically to every category file in this set).
#
# RECONCILIATION (docs/detections/suricata-starter-set.md has the full
# record): 9000082 (high-volume SYN from a single source) overlaps
# rules/sigma/net_zeek_port_scan.yml — different detection method
# (Suricata packet-level SYN-flag counting vs. Zeek's own scan-detection
# notice), same underlying activity. Kept as independent confirmation —
# see ransomware_c2.rules' header for why.
#
# detection_filter/threshold values (9000082 count 50/10s, 9000083 count
# 30/10s) are the source's own illustrative defaults — tune before
# enabling. 9000081's `window:1024` is a literal Nmap default SYN window
# size fingerprint, not a placeholder — verify it still matches the Nmap
# version(s) actually seen before relying on it (window-size fingerprints
# drift across tool versions/OSes).

alert tcp $EXTERNAL_NET any -> $HOME_NET any (msg:"UNIV Possible Nmap Scan - Default Nmap SYN Window Size Pattern"; flow:to_server; flags:S; window:1024; classtype:attempted-recon; sid:9000081; rev:1;)
#alert tcp $EXTERNAL_NET any -> $HOME_NET any (msg:"UNIV High Volume of SYN Packets from Single Source - Possible Port Scan"; flow:to_server; flags:S; detection_filter:track by_src, count 50, seconds 10; classtype:attempted-recon; sid:9000082; rev:1;)
#alert icmp $EXTERNAL_NET any -> $HOME_NET any (msg:"UNIV ICMP Sweep Detected from Single External Source"; itype:8; detection_filter:track by_src, count 30, seconds 10; classtype:attempted-recon; sid:9000083; rev:1;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"UNIV Known Vulnerability Scanner User-Agent - Nessus"; flow:established,to_server; http.user_agent; content:"Nessus"; nocase; classtype:attempted-recon; sid:9000084; rev:1;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"UNIV Known Vulnerability Scanner User-Agent - masscan"; flow:established,to_server; http.user_agent; content:"masscan"; nocase; classtype:attempted-recon; sid:9000085; rev:1;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"UNIV Known Vulnerability Scanner User-Agent - Zgrab"; flow:established,to_server; http.user_agent; content:"Zgrab"; nocase; classtype:attempted-recon; sid:9000086; rev:1;)
alert tcp $EXTERNAL_NET any -> $HOME_NET 3306 (msg:"UNIV External Connection Attempt to MySQL Port - Should Not Be Internet Facing"; flow:established,to_server; classtype:attempted-recon; sid:9000087; rev:1;)
alert tcp $EXTERNAL_NET any -> $HOME_NET 1433 (msg:"UNIV External Connection Attempt to MSSQL Port - Should Not Be Internet Facing"; flow:established,to_server; classtype:attempted-recon; sid:9000088; rev:1;)
alert tcp $EXTERNAL_NET any -> $HOME_NET 27017 (msg:"UNIV External Connection Attempt to MongoDB Port - Should Not Be Internet Facing"; flow:established,to_server; classtype:attempted-recon; sid:9000089; rev:1;)
alert tcp $EXTERNAL_NET any -> $HOME_NET 6379 (msg:"UNIV External Connection Attempt to Redis Port - Should Not Be Internet Facing"; flow:established,to_server; classtype:attempted-recon; sid:9000090; rev:1;)
