# University SOC starter set — Category 3: Web application attacks against LMS/portals (#446, M23 Stage 3)
# SIDs 9000021-9000030.
#
# Source: university_soc_starter_ruleset.rules, supplied by the repo owner.
# Rule text below is VERBATIM from that source. ALL RULES DISABLED — see
# rules/suricata/auth_sso_abuse.rules' header for the full disable/
# provenance note (applies identically to every category file in this set).

alert http $EXTERNAL_NET any -> $HOME_NET 443 (msg:"UNIV SQL Injection Attempt Against LMS - UNION SELECT in URI"; flow:established,to_server; http.uri; content:"UNION"; nocase; content:"SELECT"; nocase; distance:0; classtype:web-application-attack; sid:9000021; rev:1;)
alert http $EXTERNAL_NET any -> $HOME_NET 443 (msg:"UNIV SQL Injection Attempt Against LMS - Classic OR 1=1 Pattern"; flow:established,to_server; http.uri; content:"' OR '1'='1"; classtype:web-application-attack; sid:9000022; rev:1;)
alert http $EXTERNAL_NET any -> $HOME_NET 443 (msg:"UNIV XSS Attempt Against LMS - Script Tag in Query String"; flow:established,to_server; http.uri; content:"<script"; nocase; classtype:web-application-attack; sid:9000023; rev:1;)
alert http $EXTERNAL_NET any -> $HOME_NET 443 (msg:"UNIV Directory Traversal Attempt Against Portal"; flow:established,to_server; http.uri; content:"../../../"; classtype:web-application-attack; sid:9000024; rev:1;)
alert http $EXTERNAL_NET any -> $HOME_NET 443 (msg:"UNIV Local File Inclusion Attempt - etc/passwd in URI"; flow:established,to_server; http.uri; content:"/etc/passwd"; classtype:web-application-attack; sid:9000025; rev:1;)
alert http $EXTERNAL_NET any -> $HOME_NET 443 (msg:"UNIV Remote File Inclusion Attempt - http:// in Parameter Value"; flow:established,to_server; http.uri; content:"=http://"; nocase; classtype:web-application-attack; sid:9000026; rev:1;)
alert http $EXTERNAL_NET any -> $HOME_NET 443 (msg:"UNIV Suspicious File Upload to LMS - PHP Extension in Body"; flow:established,to_server; http.method; content:"POST"; http.uri; content:"upload"; nocase; http.request_body; content:".php"; nocase; classtype:web-application-attack; sid:9000027; rev:1;)
alert http $EXTERNAL_NET any -> $HOME_NET 443 (msg:"UNIV Known Vulnerability Scanner User-Agent - sqlmap"; flow:established,to_server; http.user_agent; content:"sqlmap"; nocase; classtype:attempted-recon; sid:9000028; rev:1;)
alert http $EXTERNAL_NET any -> $HOME_NET 443 (msg:"UNIV Known Vulnerability Scanner User-Agent - Nikto"; flow:established,to_server; http.user_agent; content:"Nikto"; nocase; classtype:attempted-recon; sid:9000029; rev:1;)
alert http $EXTERNAL_NET any -> $HOME_NET 443 (msg:"UNIV Unauthenticated Access Attempt to Admin Config Path"; flow:established,to_server; http.uri; content:"/admin/config"; nocase; classtype:attempted-admin; sid:9000030; rev:1;)
