# Suburban-SOC .gitattributes
# Force LF line endings for all shell scripts in the repo,
# regardless of the developer's local OS/git config.
# This prevents CRLF corruption that breaks bash scripts on WSL/Linux.

# Shell scripts — always LF
*.sh        text eol=lf

# Config files — always LF
*.conf      text eol=lf
# Environment files — always LF. CRLF here leaks a trailing \r into every value
# read by `source .env` in bash (breaks HMAC signing, ES/curl auth, etc.). Docker
# Compose strips it, but the many shell scripts that source .env do not.
.env        text eol=lf
.env.*      text eol=lf
*.env       text eol=lf
# Cron fragments are sourced/parsed line-by-line — keep LF
*.cron      text eol=lf
# systemd units (#557). `git config core.autocrlf` is true on the capture host, so
# without these two globs every unit file checks out CRLF while HEAD stores LF —
# `configs/systemd/*.service` were all in that state when this was added. Nothing is
# broken TODAY: verified empirically on this host with a throwaway --user unit written
# with explicit \r\n terminators, systemd strips the \r (Environment=SOC_PROBE=value
# came back without one, and ExecStart printed the unedited value). But unit files
# carry absolute paths and argument lists in exactly the way the *.conf/*.cron entries
# above were written to protect, they are `sudo cp`-ed verbatim to /etc/systemd/system,
# and relying on a parser's leniency is a weaker guarantee than not producing the
# problem. Two globs short of the hazard this file exists to prevent.
*.service   text eol=lf
*.timer     text eol=lf
# Zeek Intel feed files — tab-separated, MUST be LF (CRLF corrupts the last field)
*.dat       text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.json      text eol=lf

# Markdown — always LF
*.md        text eol=lf

# Python — always LF
*.py        text eol=lf

# Windows PowerShell scripts — CRLF is correct on Windows
*.ps1       text eol=crlf

# Binary files — no line ending conversion
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
# Kibana dashboards are line-delimited JSON, not binary — keep as text (LF) so diffs
# and secret scanning see their contents (audit P2-16).
*.ndjson    text eol=lf
*.pcap      binary
*.docx      binary
