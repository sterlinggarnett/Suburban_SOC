# =============================================================================
# Suburban-SOC stack secrets & config (WS0.1)
#
#   cp .env.example .env
#   # then set strong, unique values below. NEVER commit .env.
#
# Generate strong values:
#   ELASTIC_PASSWORD / KIBANA_PASSWORD / LOGSTASH_PASSWORD : openssl rand -base64 24
#   KIBANA_ENCRYPTION_KEY (must be >= 32 chars)            : openssl rand -hex 32
# =============================================================================

# --- Stack version & licensing ---
STACK_VERSION=9.3.2
CLUSTER_NAME=suburban-soc
LICENSE=basic

# --- Host port mappings ---
ES_PORT=9200
KIBANA_PORT=5601

# --- Secrets (REQUIRED — the setup container refuses to start if blank) ---
# Superuser password for the built-in `elastic` account.
ELASTIC_PASSWORD=changeme_elastic
# Password for the built-in `kibana_system` service account.
KIBANA_PASSWORD=changeme_kibana
# Password for the least-privilege `logstash_internal` user (role: logstash_writer).
LOGSTASH_PASSWORD=changeme_logstash
# Kibana saved-object / reporting encryption key — MUST be at least 32 characters.
KIBANA_ENCRYPTION_KEY=changeme_must_be_at_least_32_chars_long
# Shared secret for HMAC-signing the SOAR /alert webhook (Logstash -> AI agent).
# openssl rand -hex 32
SOC_AGENT_HMAC_SECRET=changeme_soar_webhook_secret
# #246: SEPARATE secret for /approve (executes isolation) and /pending (lists
# drafted actions). Deliberately different from SOC_AGENT_HMAC_SECRET above and
# NOT provisioned to the logstash service — Logstash only ever needs to sign
# /alert, never to approve what it reports. Keep this value out of Logstash's
# environment/config entirely; only the AI agent (to verify) and the human
# operator's own shell (to sign /approve, /pending calls) should ever hold it.
# openssl rand -hex 32
SOC_APPROVER_HMAC_SECRET=changeme_approver_secret
# Label recorded as the approver of record for every action approved with
# SOC_APPROVER_HMAC_SECRET above — shown in the claim doc, approval-queue row,
# and Kibana case comment. Not a password; just an audit-trail display name for
# whoever holds that secret. Blank = falls back to "soc-analyst".
SOC_APPROVER_IDENTITY=soc-analyst
# WS2.3: password for the least-privilege `soc_agent` Kibana user the agent uses to
# open/close tracked Cases. Set it to enable case tracking; blank = setup skips the
# user and the agent skips cases (alert handling still works). openssl rand -hex 24
SOC_AGENT_KIBANA_PASSWORD=changeme_soc_agent_kibana_password
# audit #167: password for the least-privilege `slo_metrics` user (role:
# slo_metrics_reader) — slo-metrics.service uses this instead of the elastic
# superuser. openssl rand -base64 24
SLO_METRICS_PASSWORD=changeme_slo_metrics
# #245: password for the least-privilege `agent_checkpoints` user (role:
# agent_checkpoints) — the AI agent's checkpoint read/write/claim access,
# deliberately separate from logstash_internal so it isn't handed to Logstash's
# shared credential. Blank = the provision step never creates the user, so
# every agent-checkpoints-* call 401s (no such identity, not just insufficient
# privilege): /alert intake still drafts alerts (checkpoint writes there are
# best-effort, per agent.py's _checkpoint_or_warn), but /approve execution
# fails closed (503) rather than risk a double-execution — set this for the
# approval gate to actually work. openssl rand -base64 24
AGENT_CHECKPOINTS_PASSWORD=changeme_agent_checkpoints

# #256: password for the least-privilege `agent_checkpoints_compactor` user
# (role: agent_checkpoints_compactor) — scripts/setup/ai_agent/
# compact_agent_checkpoints.py's scheduled per-document TTL retention.
# Deliberately a SEPARATE credential from AGENT_CHECKPOINTS_PASSWORD above,
# not a wider grant on that one: agent_checkpoints's whole point (#245) is
# holding NO delete privilege, so the live agent/CLI credential can't erase
# a claim doc and reopen the at-most-once execution gate even if
# compromised. This one holds read+delete, used ONLY by the scheduled
# compaction script, and its own TERMINAL_CLAIM_PHASES never includes
# CLAIMED (asserted in the script). Blank = the provision step never
# creates the user, so the compaction script 401s and deletes nothing —
# fails closed into "checkpoints just keep growing", never into an
# unintended delete. openssl rand -base64 24
AGENT_CHECKPOINTS_COMPACTOR_PASSWORD=changeme_agent_checkpoints_compactor

# #222: dedicated identity for configs/intel/refresh_intel.sh, so the now-
# scheduled (every 6h, intel-refresh.timer) threat-intel feed refresh doesn't
# run as the elastic superuser — same reasoning as AGENT_CHECKPOINTS_PASSWORD
# above. Blank = the script falls back to ELASTIC_PASSWORD (works, but not
# least-privilege — set this). openssl rand -base64 24
INTEL_WRITER_PASSWORD=changeme_intel_writer

# --- AI agent notifications & LLM triage (optional; blank = feature disabled) ---
# ntfy topic for mobile push alerts. Pick a long, unguessable value.
# Also the fallback topic for the 'unassigned' tenant (single-tenant deploys).
NTFY_TOPIC=
# OpenAI-compatible API key + endpoint for Level-1 AI triage.
LLM_API_KEY=
LLM_API_URL=https://api.openai.com/v1/chat/completions
LLM_MODEL=gpt-4
# Allow sending (sanitised) telemetry to a HOSTED LLM endpoint. Default false:
# with the hosted default URL above, AI triage degrades gracefully instead of
# egressing. Set true only with a deliberate hosted-LLM decision, or point
# LLM_API_URL at a local Ollama and leave this false.
LLM_ALLOW_HOSTED=false
# Discord webhook for SOC channel notifications (fallback for 'unassigned').
DISCORD_WEBHOOK_URL=

# --- Per-tenant notifications (WS0.3) ---
# One set per tenant slug, suffixed UPPER_SNAKE (home-smith -> HOME_SMITH).
# Notify vars fall back to the global topic/webhook above.
# (#109: per-tenant ROUTER_HOST_* on the agent is GONE — the hive-mind-broker now
#  owns router resolution via its inventory.yaml; see below.)
# NTFY_TOPIC_HOME_SMITH=subsoc-home-smith
# DISCORD_WEBHOOK_URL_HOME_SMITH=https://discord.com/api/webhooks/...

# --- Hive-Mind broker (router block dispatcher; #109) ---
# The slim AI agent has no ssh/sudo, so it routes containment to the broker over an
# authenticated webhook. The broker owns the per-tenant router inventory
# (scripts/hive-mind-broker/inventory.yaml — copy from inventory.example.yaml) and
# applies the nftables block.
# Shared secret for HMAC-signing broker webhook requests. openssl rand -hex 32
# Must be IDENTICAL on the agent and the broker (both read HIVE_MIND_SECRET).
# #277: must ALSO be DIFFERENT from SOC_AGENT_HMAC_SECRET and
# SOC_APPROVER_HMAC_SECRET above (same reasoning as SOC_APPROVER_HMAC_SECRET's
# own note) — since #277, this secret also authenticates the broker's dispatch
# RESPONSE, not just the agent's outbound request. If it collides with either,
# the agent fails closed (refuses all broker dispatch, logged CRITICAL) rather
# than silently running with the guarantee void.
HIVE_MIND_SECRET=changeme_broker_secret
# #273: audit-trail display names bound to whoever holds HIVE_MIND_SECRET above.
# The broker records these as the approver of record on its own queue/audit rows;
# it never trusts an "approver" field supplied in the request body (that would let
# any secret-holder stamp an arbitrary analyst name onto an executed block).
# Not passwords — just labels. Blank falls back to the defaults shown.
# BROKER_APPROVER_IDENTITY  — a human approving a drafted block at the broker's
#                             own /approve endpoint.
# BROKER_DISPATCH_IDENTITY  — the AI agent relaying a block it already gated
#                             upstream via /webhook/dispatch.
# Whatever the caller put in the body's "approver" field is still kept on both
# endpoints, under `upstream_approver_claimed` — explicitly a claim, never the
# approver of record. Note both endpoints share HIVE_MIND_SECRET, so these
# labels record which endpoint was used, not proof of who the caller was.
BROKER_APPROVER_IDENTITY=broker-operator
BROKER_DISPATCH_IDENTITY=soc-ai-agent
# Broker URL the agent dispatches to (default: the compose service name).
# BROKER_URL=http://hive_mind_broker:8000
# Host dir holding the broker's router SSH key(s), mounted read-only at /root/.ssh.
# HIVE_MIND_SSH_DIR=~/.ssh
# Legacy auto-block on the broker's /webhook/alert (Kibana path). Keep false — the
# agent is the approval authority; /webhook/dispatch is the agent's execute path.
# AUTONOMOUS_BLOCK_ENABLED=false
# audit #171: password for the least-privilege `hive_mind_broker` user (role:
# soc_audit_appender, same append-only role as logstash_internal's audit grant) —
# persists a durable record of denied/replayed/invalid-signature broker requests
# to soc-audit-unassigned. Blank = setup skips the user and the broker just logs
# the denial locally (auth enforcement is unaffected either way). openssl rand -base64 24
BROKER_AUDIT_PASSWORD=changeme_broker_audit
