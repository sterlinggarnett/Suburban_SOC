# Fires checkpoints-compact.service daily — agent-checkpoints-<tenant> is a
# low-write-volume index (one doc per alert/claim, not per-event telemetry),
# so unlike intel-refresh.timer's 6h cadence a daily run is more than enough
# to keep pace with retention-eligible growth.
[Unit]
Description=Run Suburban-SOC agent-checkpoints TTL retention (#256) daily
Documentation=https://github.com/voltron-1/Suburban_SOC

[Timer]
# security-auditor round 1 LOW: OnCalendar= (not OnBootSec=/OnUnitActiveSec=)
# for two reasons. (1) Persistent=true is a genuine no-op for
# OnBootSec=/OnUnitActiveSec= timers (systemd only honors it for
# OnCalendar=) — with OnCalendar= it actually works, so a missed run (host
# down at 02:30) catches up on next boot instead of silently waiting a full
# day. (2) Ordering against the daily SLM snapshot (schedule "0 30 1 * * ?"
# in configs/elasticsearch/ilm/slm-policy.json, i.e. 01:30) — the only
# recovery control for a bad delete on this credential (security-auditor
# round 1 MEDIUM-4) is that snapshot. OnBootSec=/OnUnitActiveSec='s run
# time drifts against that fixed clock time, so a delete could land right
# before a snapshot, leaving up to ~24h of exposure. Fixed at 02:30 —
# an hour after the snapshot completes — makes the ordering deterministic
# instead of coincidental.
OnCalendar=*-*-* 02:30:00
RandomizedDelaySec=15min
Persistent=true

[Install]
WantedBy=timers.target
